MATRIX_SERVER_NAME=matrix.wrytte.com
MATRIX_CLIENT_BASE_URL=https://matrix.wrytte.com
POSTGRES_DB=dendrite
POSTGRES_USER=dendrite
POSTGRES_PASSWORD=change_this_postgres_password
TURN_SHARED_SECRET=change_this_turn_shared_secret
TURN_REALM=turn.matrix.wrytte.com
TURN_HOST=turn.matrix.wrytte.com
# Public IPv4 address of the machine running coturn (not a private Docker IP).
TURN_EXTERNAL_IP=203.0.113.10
# Absolute host paths to a publicly trusted certificate for TURN_HOST.
TURN_TLS_CERT=/etc/letsencrypt/live/turn.matrix.wrytte.com/fullchain.pem
TURN_TLS_KEY=/etc/letsencrypt/live/turn.matrix.wrytte.com/privkey.pem
METRICS_PASSWORD=change_this_metrics_password
